{
  "name": "@cs/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "tsc --noEmit && node --test \"dist/**/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "setup:timesfm": "cd scripts && uv venv && uv pip install --native-tls -r requirements.txt"
  },
  "dependencies": {
    "@cs/domain": "workspace:*",
    "@cs/knowledge": "workspace:*",
    "@google-cloud/pubsub": "^5.3.0",
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^12.9.0",
    "lru-cache": "^11.4.0",
    "pdf-parse": "^2.4.5",
    "ts-morph": "^28.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "@types/pdf-parse": "^1.1.5",
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0"
  }
}