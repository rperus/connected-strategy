{
  "name": "connected-strategy",
  "version": "2.6.0",
  "private": true,
  "description": "Connected Strategy \u2014 Local-first strategic control tower for multi-project analysis, launcher, prompt packets, and continuous improvement.",
  "scripts": {
    "dev": "pnpm --filter @cs/web dev & pnpm --filter @cs/server dev",
    "dev:web": "pnpm --filter @cs/web dev",
    "dev:server": "pnpm --filter @cs/server dev",
    "dev:desktop": "pnpm --filter @cs/desktop dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @cs/web build",
    "build:server": "pnpm --filter @cs/server build",
    "test": "pnpm -r test",
    "test:watch": "vitest",
    "lint": "echo \"Linting pending setup\"",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "db:backup": "npx tsx scripts/backup-db.ts"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "expect": "30.4.1",
    "png-to-ico": "3.0.1",
    "sharp": "0.34.5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp",
      "@clerk/shared",
      "electron-builder",
      "esbuild",
      "sqlite3"
    ]
  }
}